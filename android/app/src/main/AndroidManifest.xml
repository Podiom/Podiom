<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline/online state for the connection screen's reachability probe. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Local discovery (NsdManager). ACCESS_WIFI_STATE is needed to take the
         multicast lock; without it mDNS responses are filtered on many devices. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Voice input (VoiceButton.svelte uses getUserMedia + MediaRecorder). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13+ requires this to be requested at runtime before any notification is
         shown. Podiom asks for it from Settings, in the context of explaining what it
         would notify about, rather than at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
