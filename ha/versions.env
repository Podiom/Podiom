# Pinned versions for the Podiom Home Assistant add-on image (HA18).
# Single source of truth: the Makefile `ha-image` target and release CI source
# this file and pass every key as a docker build-arg.
#
# Verified 2026-07-04:
#   BUILD_FROM   — ghcr.io manifest list (amd64 + arm64), latest release of
#                  hassio-addons/app-debian-base (Debian Trixie slim, s6-overlay v3 + bashio)
#   CLAUDE/CODEX — `npm view <pkg> version`
#   MCP_PROXY    — https://pypi.org/pypi/mcp-proxy/json (sparfenyuk/mcp-proxy)
#   TTYD/YQ      — GitHub releases API; sha256 computed from downloaded release assets

BUILD_FROM=ghcr.io/hassio-addons/debian-base:9.3.0
NODE_MAJOR=22
CLAUDE_CODE_VERSION=2.1.201
CODEX_VERSION=0.142.5
MCP_PROXY_VERSION=0.12.0

TTYD_VERSION=1.7.7
TTYD_SHA256_AMD64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
TTYD_SHA256_ARM64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165

YQ_VERSION=v4.53.3
YQ_SHA256_AMD64=fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4
YQ_SHA256_ARM64=578648e463a11c1b6db6010cbf41eafed6bee79466fcffa1bb446672cf7945ea
