# Pinned versions for the Podiom Home Assistant add-on image (HA18).
# Single source of truth: the Makefile `ha-image` target and release CI source
# this file and pass every key as a docker build-arg.
#
# Verified 2026-07-04:
#   BUILD_FROM   — ghcr.io manifest list (amd64 + arm64), latest release of
#                  hassio-addons/app-debian-base (Debian Trixie slim, s6-overlay v3 + bashio)
#   CLAUDE/CODEX — `npm view <pkg> version`
#   MCP_PROXY    — https://pypi.org/pypi/mcp-proxy/json (sparfenyuk/mcp-proxy)
#                  mcp<2 constraint injected: mcp 2.0.0 removed request_ctx which
#                  mcp-proxy 0.12.0 still imports; upgrade mcp-proxy before removing it
#   UV           — https://pypi.org/pypi/uv/json (astral-sh/uv; ships uv + uvx)
#   TTYD         — GitHub releases API; sha256 computed from downloaded release assets

BUILD_FROM=ghcr.io/hassio-addons/debian-base:9.3.0
NODE_MAJOR=22
CLAUDE_CODE_VERSION=2.1.201
CODEX_VERSION=0.142.5
MCP_PROXY_VERSION=0.12.0
UV_VERSION=0.11.26

TTYD_VERSION=1.7.7
TTYD_SHA256_AMD64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
TTYD_SHA256_ARM64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165

# --- Optional language toolchains (add-on `toolchains` option) ---------------
# These are NOT baked into the image. podiom-toolchains downloads them into
# /data/podiom/toolchains/ on start, for whichever toolchains the user ticked.
# Only the bootstrap downloads carry a checksum here; rustup, swiftly and uv
# verify everything they fetch afterwards themselves.
#
# Verified 2026-08-07:
#   GO       — https://go.dev/dl/?mode=json (first entry = current stable);
#              sha256 taken from that index, not recomputed
#   RUSTUP   — https://static.rust-lang.org/rustup/release-stable.toml;
#              sha256 computed from the downloaded archive/<ver>/<triple> binary
#   RUST     — [pkg.rust] version in
#              https://static.rust-lang.org/dist/channel-rust-stable.toml
#   SWIFTLY  — https://www.swift.org/install/linux/swiftly; sha256 computed from
#              the downloaded download.swift.org tarballs
#   SWIFT    — latest non-prerelease swiftlang/swift GitHub release
#   PYTHON   — latest cpython linux-gnu build in astral-sh/python-build-standalone
#              (what `uv python install` resolves against)

GO_VERSION=1.26.5
GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
GO_SHA256_ARM64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49

RUSTUP_INIT_VERSION=1.29.0
RUSTUP_INIT_SHA256_AMD64=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
RUSTUP_INIT_SHA256_ARM64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
RUST_VERSION=1.97.1

SWIFTLY_VERSION=1.1.3
SWIFTLY_SHA256_AMD64=4c4adb7b7ad7910f38c52b94a938c309586fe395e1fe1538c397384ee36bfff0
SWIFTLY_SHA256_ARM64=cc4f912fff6c7f53704fc6d22f9e8ee7fdf6bd574ad276998f7502418bf5a45a
SWIFT_VERSION=6.3.3
# swiftly cannot auto-detect Debian Trixie and has no debian13 target — it
# accepts only ubuntu{18.04,20.04,22.04,24.04}, fedora39, ubi9, amazonlinux2,
# debian12. We therefore run the debian12 toolchain on Trixie, which works
# because glibc is backwards compatible. Revisit when swiftly adds debian13, or
# when BUILD_FROM moves to a Debian whose glibc the debian12 build predates.
SWIFTLY_PLATFORM=debian12

# Must be a version the BUNDLED uv (UV_VERSION above) has in its index — a
# CPython newer than that uv release will fail with "No download found".
# Check with: uv python list --all-versions
PYTHON_VERSION=3.14.6
