#!/usr/bin/env bash
# ==============================================================================
# podiom-terminal: the command ttyd runs for HA /terminal/* sessions.
# podiomd's reverse proxy injects arguments via ttyd's --url-arg mechanism:
#
#   podiom-terminal <flow> [--return-url=<url>]
#
# Contract: NEVER exit early — exiting kills the ttyd session and leaves a dead
# terminal. Every path ends in `exec bash -il`. No `set -e` for the same reason.
# ==============================================================================

flow=""
return_url=""

for arg in "$@"; do
    case "${arg}" in
        --return-url=*) return_url="${arg#--return-url=}" ;;
        --*)            ;; # ignore unknown flags
        *)              [ -z "${flow}" ] && flow="${arg}" ;;
    esac
done

run_onboard() {
    echo "Starting the Podiom onboarding wizard."
    echo "It checks the bundled Claude/Codex CLIs, guides login, creates your first agent,"
    echo "and marks onboarding complete when it finishes."
    echo
    PODIOM_OFFER_AUTOSTART=0 podiom onboard
}

banner() {
    echo "=================================================="
    case "${flow}" in
        onboard) echo " Podiom onboarding wizard" ;;
        shell)   echo " Podiom maintenance shell" ;;
        *)       echo " Podiom terminal" ;;
    esac
    echo "=================================================="
}

shell_help() {
    echo "For provider re-authentication later, run one of:"
    echo "  claude /login"
    echo "  codex login --device-auth"
    echo
    echo "For profile-scoped re-authentication, create the directory first and prefix"
    echo "the CLI's environment variable, for example:"
    echo "  mkdir -p /data/home/.claude-work && CLAUDE_CONFIG_DIR=/data/home/.claude-work claude /login"
    echo "  mkdir -p /data/home/.codex-work && CODEX_HOME=/data/home/.codex-work codex login --device-auth"
}

main() {
    case "${flow}" in
        onboard|shell) ;;
        "")
            echo "Podiom terminal."
            echo "Open one of these:"
            echo "  .../terminal/onboard           run the Podiom onboarding wizard"
            echo "  .../terminal/shell             open a maintenance shell"
            echo "Dropping to a shell."
            shell_help
            return
            ;;
        *)
            echo "Unknown flow '${flow}' (expected onboard or shell). Dropping to a shell."
            shell_help
            return
            ;;
    esac

    banner
    case "${flow}" in
        onboard) run_onboard ;;
        shell)   shell_help ;;
    esac
    echo
    if [ -n "${return_url}" ]; then
        echo "Return to Podiom: ${return_url}"
    else
        echo "Return to the Podiom tab in your Home Assistant sidebar."
    fi
    echo "You are now in a shell inside the add-on container."
}

main "$@"
exec bash -il
