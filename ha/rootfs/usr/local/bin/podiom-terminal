#!/usr/bin/env bash
# ==============================================================================
# podiom-terminal (HA22/HA23): the single command ttyd runs for every
# /terminal/* session. podiomd's reverse proxy injects the arguments via
# ttyd's --url-arg mechanism:
#
#   podiom-terminal <cli> [--profile=<name>] [--return-url=<url>]
#
# Contract: NEVER exit — exiting kills the ttyd session and leaves a dead
# terminal. Every path (success, bad args, unknown profile) ends in
# `exec bash -il`. No `set -e` for the same reason.
# ==============================================================================

CONFIG_FILE="${PODIOM_HOME:-/data/podiom}/config.yaml"
PROFILE_RE='^[A-Za-z0-9._-]{1,64}$'

cli=""
profile=""
return_url=""

for arg in "$@"; do
    case "${arg}" in
        --profile=*)    profile="${arg#--profile=}" ;;
        --return-url=*) return_url="${arg#--return-url=}" ;;
        --*)            ;; # ignore unknown flags
        *)              [ -z "${cli}" ] && cli="${arg}" ;;
    esac
done

list_profiles() {
    if [ -f "${CONFIG_FILE}" ]; then
        yq eval '.profiles[].name' "${CONFIG_FILE}" 2>/dev/null | sed 's/^/  - /'
    fi
}

# Resolve a profile name to its directory and export the CLI's env var.
# Returns non-zero (with a message) on unknown profile / missing dir field.
setup_profile() {
    local field envvar dir
    case "${cli}" in
        claude) field="config_dir"; envvar="CLAUDE_CONFIG_DIR" ;;
        codex)  field="home_dir";   envvar="CODEX_HOME" ;;
    esac
    # strenv() keeps the (already regex-validated) name out of yq expression
    # syntax entirely.
    dir="$(PODIOM_PROFILE="${profile}" yq eval \
        ".profiles[] | select(.name == strenv(PODIOM_PROFILE)) | .${field}" \
        "${CONFIG_FILE}" 2>/dev/null)"
    if [ -z "${dir}" ] || [ "${dir}" = "null" ]; then
        echo "Unknown profile '${profile}' (or it has no ${field}). Known profiles:"
        list_profiles
        echo "Continuing without a profile."
        return 1
    fi
    dir="${dir/#\~/$HOME}"   # config may hold unexpanded ~ paths
    mkdir -p "${dir}"
    export "${envvar}=${dir}"
    echo "Profile '${profile}': ${envvar}=${dir}"
    return 0
}

run_login() {
    case "${cli}" in
        claude)
            # Claude Code has no `login` subcommand; /login is its in-REPL
            # command and a leading slash-command argument runs it on launch
            # (docs: code.claude.com/docs/en/authentication). In a container
            # the browser can't reach the local OAuth callback, so the flow
            # falls back to "paste the code shown in your browser" — which
            # works fine over this web terminal.
            claude /login
            ;;
        codex)
            # Plain `codex login` redirects OAuth to localhost:1455 inside
            # this container, which your browser cannot reach. The device-code
            # flow prints a URL + one-time code instead (verified against
            # developers.openai.com/codex/auth). Note: device code login must
            # be enabled in your ChatGPT security/workspace settings.
            codex login --device-auth
            ;;
    esac
}

banner() {
    echo "=================================================="
    echo " Podiom onboarding terminal — ${cli} login"
    [ -n "${profile}" ] && echo " Profile: ${profile}"
    echo "=================================================="
}

main() {
    case "${cli}" in
        claude|codex) ;;
        "")
            echo "Podiom onboarding terminal."
            echo "Open one of these to log in a CLI:"
            echo "  .../terminal/claude            log in the claude CLI"
            echo "  .../terminal/codex             log in the codex CLI"
            echo "  .../terminal/<cli>/<profile>   log in a specific profile"
            echo "Dropping to a shell."
            return
            ;;
        *)
            echo "Unknown CLI '${cli}' (expected claude or codex). Dropping to a shell."
            return
            ;;
    esac

    if [ -n "${profile}" ]; then
        if ! [[ "${profile}" =~ ${PROFILE_RE} ]]; then
            echo "Invalid profile name. Dropping to a shell."
            profile=""
        elif [ ! -f "${CONFIG_FILE}" ]; then
            echo "No config file at ${CONFIG_FILE}; cannot resolve profile '${profile}'."
            profile=""
        elif ! setup_profile; then
            profile=""
        fi
    fi

    banner
    run_login
    echo
    if [ -n "${return_url}" ]; then
        echo "Done. Return to Podiom: ${return_url}"
    else
        echo "Done. Return to the Podiom tab in your Home Assistant sidebar."
    fi
    echo "You are now in a shell inside the add-on container."
}

main "$@"
exec bash -il
